<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard Admin — Intern Management</title>

    <!-- =============================================
         FONTS & ICONS
    ============================================= -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

    <!-- SheetJS — Import Excel -->
    <script src="https://cdn.sheetjs.com/xlsx-0.20.2/package/dist/xlsx.full.min.js"></script>

    <style>
      /* =============================================
         VARIABLES GLOBALES
      ============================================= */
      :root {
        --primary:        #1e2242;
        --primary-dark:   #151838;
        --primary-light:  #2a2f55;
        --primary-glow:   rgba(30, 34, 66, 0.08);
        --primary-soft:   rgba(30, 34, 66, 0.12);

        --bg:             #f5f7fa;
        --bg-secondary:   #ffffff;

        --text:           #1a1f36;
        --text-soft:      #5a6a7a;
        --text-light:     #8e9aab;

        --success:        #10b981;
        --success-light:  #d1fae5;
        --warning:        #f59e0b;
        --warning-light:  #fef3c7;
        --danger:         #ef4444;
        --danger-light:   #fee2e2;
        --info:           #3b82f6;
        --info-light:     #dbeafe;

        --border:         #e5e7eb;
        --shadow:         0 1px 3px rgba(0, 0, 0, 0.05);
        --shadow-md:      0 4px 12px rgba(0, 0, 0, 0.08);
        --shadow-lg:      0 10px 30px rgba(0, 0, 0, 0.1);

        --radius:         16px;
        --radius-sm:      12px;
        --radius-lg:      24px;
      }

      /* =============================================
         RESET
      ============================================= */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Inter", sans-serif;
        background: var(--bg);
        color: var(--text);
        overflow-x: hidden;
      }

      /* =============================================
         SIDEBAR
      ============================================= */
      #sidebar {
        position: fixed;
        top: 0;
        left: 0;
        width: 280px;
        height: 100%;
        background: var(--bg-secondary);
        z-index: 1000;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        overflow-x: hidden;
        box-shadow: var(--shadow-md);
      }

      #sidebar.collapsed {
        width: 80px;
      }

      .sidebar-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 24px;
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--primary);
        border-bottom: 1px solid var(--border);
      }

      .sidebar-brand i {
        font-size: 1.8rem;
        flex-shrink: 0;
      }

      .sidebar-brand span {
        white-space: nowrap;
      }

      #sidebar.collapsed .sidebar-brand span {
        display: none;
      }

      /* Navigation sidebar */
      .sidebar-nav {
        list-style: none;
        padding: 20px 12px;
      }

      .sidebar-nav li {
        margin-bottom: 8px;
      }

      .sidebar-nav li a {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 16px;
        border-radius: var(--radius-sm);
        color: var(--text-soft);
        text-decoration: none;
        font-weight: 500;
        font-size: 0.9rem;
        transition: all 0.2s;
      }

      .sidebar-nav li a i {
        width: 24px;
        font-size: 1.2rem;
        flex-shrink: 0;
      }

      .sidebar-nav li a span {
        white-space: nowrap;
      }

      #sidebar.collapsed .sidebar-nav li a span {
        display: none;
      }

      .sidebar-nav li.active a {
        background: var(--primary);
        color: white;
      }

      .sidebar-nav li a:hover:not(.nav-logout) {
        background: var(--primary-soft);
        color: var(--primary);
      }

      .nav-logout {
        color: var(--danger) !important;
      }

      .nav-logout:hover {
        background: var(--danger-light) !important;
        color: var(--danger) !important;
      }

      /* =============================================
         CONTENT WRAPPER
      ============================================= */
      #content {
        margin-left: 280px;
        transition: all 0.3s;
        min-height: 100vh;
      }

      #sidebar.collapsed ~ #content {
        margin-left: 80px;
      }

      /* =============================================
         NAVBAR SUPÉRIEURE
      ============================================= */
      .top-navbar {
        background: var(--bg-secondary);
        padding: 12px 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 99;
      }

      .sidebar-toggle-btn {
        font-size: 1.3rem;
        cursor: pointer;
        color: var(--text-soft);
        background: none;
        border: none;
        padding: 4px;
      }

      .search-bar {
        display: flex;
        align-items: center;
        background: var(--bg);
        border-radius: 40px;
        padding: 8px 16px;
        gap: 8px;
        width: 300px;
      }

      .search-bar i {
        color: var(--text-light);
      }

      .search-bar input {
        border: none;
        background: none;
        outline: none;
        width: 100%;
        font-size: 0.85rem;
        font-family: inherit;
      }

      .navbar-actions {
        display: flex;
        align-items: center;
        gap: 20px;
        position: relative;
      }

      /* =============================================
         NOTIFICATIONS DROPDOWN
      ============================================= */
      .notification-bell {
        position: relative;
        color: var(--text-soft);
        font-size: 1.2rem;
        cursor: pointer;
      }

      .notification-badge {
        position: absolute;
        top: -8px;
        right: -8px;
        background: var(--danger);
        color: white;
        font-size: 0.65rem;
        padding: 2px 6px;
        border-radius: 20px;
      }

      .notification-dropdown {
        position: absolute;
        top: 100%;
        right: 0;
        width: 420px;
        background: var(--bg-secondary);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-lg);
        border: 1px solid var(--border);
        z-index: 1000;
        margin-top: 12px;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
        max-height: 500px;
        overflow-y: auto;
      }

      .notification-dropdown.active {
        opacity: 1;
        visibility: visible;
      }

      .notification-dropdown-header {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border);
        font-weight: 600;
        font-size: 1rem;
        background: var(--bg-secondary);
        position: sticky;
        top: 0;
      }

      .notification-item {
        padding: 14px 20px;
        border-bottom: 1px solid var(--border);
        transition: background 0.2s;
      }

      .notification-item:hover {
        background: var(--bg);
      }

      .notification-item-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
      }

      .notification-sender-name {
        font-weight: 600;
        color: var(--text);
      }

      .notification-date {
        font-size: 0.7rem;
        color: var(--text-light);
      }

      .notification-phase-label {
        font-size: 0.75rem;
        color: var(--text-soft);
        margin-bottom: 4px;
      }

      .notification-course-label {
        font-size: 0.8rem;
        color: var(--text-soft);
        margin-bottom: 10px;
      }

      .notification-action-btns {
        display: flex;
        gap: 12px;
        margin-top: 8px;
      }

      .notification-action-btns button {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--text-light);
        font-size: 0.85rem;
        padding: 4px 8px;
        border-radius: 8px;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }

      .btn-notification-view:hover {
        background: var(--info-light);
        color: var(--info);
      }

      .btn-notification-delete:hover {
        background: var(--danger-light);
        color: var(--danger);
      }

      .admin-avatar img {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
      }

      /* =============================================
         CONTENU PRINCIPAL
      ============================================= */
      .main-content {
        padding: 28px;
      }

      /* En-tête de page */
      .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
        flex-wrap: wrap;
        gap: 16px;
      }

      .page-header h1 {
        font-size: 1.8rem;
        font-weight: 600;
        color: var(--text);
      }

      .page-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
        color: var(--text-light);
        margin-top: 4px;
      }

      /* =============================================
         BOUTONS
      ============================================= */
      .btn-primary {
        background: var(--primary);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 40px;
        font-weight: 500;
        font-family: inherit;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
      }

      .btn-primary:hover {
        background: var(--primary-dark);
        transform: translateY(-1px);
      }

      .btn-secondary {
        background: var(--bg);
        color: var(--text-soft);
        border: 1px solid var(--border);
        padding: 8px 16px;
        border-radius: 40px;
        font-family: inherit;
        cursor: pointer;
      }

      .btn-danger {
        background: var(--danger);
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 40px;
        font-family: inherit;
        cursor: pointer;
      }

      .btn-danger:hover {
        background: #dc2626;
      }

      .btn-add-week {
        margin-top: 16px;
        background: var(--primary-soft);
        color: var(--primary);
        border: none;
        padding: 10px 16px;
        border-radius: 40px;
        cursor: pointer;
        font-family: inherit;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
      }

      .btn-add-week:hover {
        background: var(--primary);
        color: white;
      }

      /* =============================================
         CARTES STATISTIQUES
      ============================================= */
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
        margin-bottom: 32px;
      }

      .stat-card {
        background: var(--bg-secondary);
        border-radius: var(--radius);
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: var(--shadow);
        transition: all 0.2s;
      }

      .stat-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
      }

      .stat-card-icon {
        width: 56px;
        height: 56px;
        background: var(--primary-soft);
        border-radius: var(--radius-sm);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--primary);
        font-size: 1.8rem;
        flex-shrink: 0;
      }

      .stat-card-value {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--text);
      }

      .stat-card-label {
        color: var(--text-light);
        font-size: 0.85rem;
      }

      /* =============================================
         TABLEAUX
      ============================================= */
      .table-section {
        background: var(--bg-secondary);
        border-radius: var(--radius);
        padding: 20px;
        margin-bottom: 28px;
        box-shadow: var(--shadow);
      }

      .table-section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 16px;
      }

      .table-section-header h3 {
        font-size: 1.2rem;
        font-weight: 600;
      }

      .data-table {
        width: 100%;
        border-collapse: collapse;
      }

      .data-table th {
        text-align: left;
        padding: 12px;
        font-weight: 600;
        font-size: 0.8rem;
        color: var(--text-light);
        border-bottom: 1px solid var(--border);
      }

      .data-table td {
        padding: 14px 12px;
        border-bottom: 1px solid var(--border);
        font-size: 0.85rem;
      }

      .data-table tbody tr:hover {
        background: var(--bg);
      }

      /* Avatar initiales */
      .user-avatar {
        width: 36px;
        height: 36px;
        background: var(--primary-soft);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--primary);
        font-weight: 600;
        margin-right: 8px;
        font-size: 0.8rem;
      }

      /* =============================================
         BADGES DE STATUT
      ============================================= */
      .status-badge {
        display: inline-flex;
        padding: 4px 12px;
        border-radius: 30px;
        font-size: 0.7rem;
        font-weight: 600;
      }

      /* Statuts actifs / en cours / validé */
      .status-actif,
      .status-en-cours,
      .status-valide {
        background: var(--success-light);
        color: var(--success);
      }

      /* Statuts terminés */
      .status-termine {
        background: var(--info-light);
        color: var(--info);
      }

      /* Statuts suspendus / inactifs */
      .status-suspendu,
      .status-inactif,
      .status-reprendre {
        background: var(--danger-light);
        color: var(--danger);
      }

      /* Statuts en attente */
      .status-en-attente {
        background: var(--warning-light);
        color: var(--warning);
      }

      /* =============================================
         BOUTONS D'ACTION SUR LES LIGNES
      ============================================= */
      .row-action-btns {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
      }

      .row-action-btn {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--text-light);
        font-size: 1rem;
        padding: 4px;
        transition: color 0.2s;
      }

      .row-action-btn.btn-view:hover   { color: var(--info); }
      .row-action-btn.btn-edit:hover   { color: var(--warning); }
      .row-action-btn.btn-delete:hover { color: var(--danger); }
      .row-action-btn.btn-export:hover { color: var(--success); }

      /* =============================================
         ACCORDÉON PHASES
      ============================================= */
      .phase-accordion {
        margin-bottom: 20px;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        background: var(--bg-secondary);
      }

      .phase-accordion-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 24px;
        background: var(--bg-secondary);
        cursor: pointer;
        transition: background 0.2s;
      }

      .phase-accordion-header:hover {
        background: var(--bg);
      }

      .phase-accordion-title {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 600;
        font-size: 1.1rem;
      }

      .phase-accordion-title i {
        color: var(--primary);
        font-size: 1.2rem;
      }

      .phase-accordion-chevron {
        color: var(--text-light);
        transition: transform 0.3s ease;
      }

      .phase-accordion-body {
        display: none;
        padding: 20px;
        overflow-x: auto;
        border-top: 1px solid var(--border);
      }

      .phase-accordion-body.active {
        display: block;
      }

      /* Onglets semaines */
      .week-tabs-list {
        display: flex;
        gap: 8px;
        margin-bottom: 20px;
        flex-wrap: wrap;
      }

      .week-tab-btn {
        padding: 8px 16px;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 40px;
        cursor: pointer;
        font-size: 0.85rem;
        font-family: inherit;
        transition: all 0.2s;
      }

      .week-tab-btn:hover {
        background: var(--primary-soft);
        color: var(--primary);
      }

      .week-tab-btn.active {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
      }

      /* =============================================
         MODALS
      ============================================= */
      .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 2000;
        align-items: center;
        justify-content: center;
      }

      .modal-overlay.active {
        display: flex;
      }

      .modal-box {
        background: white;
        border-radius: var(--radius-lg);
        max-width: 900px;
        width: 90%;
        max-height: 85vh;
        overflow-y: auto;
      }

      .modal-box--sm {
        max-width: 600px;
      }

      .modal-box--xs {
        max-width: 400px;
      }

      .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 24px;
        border-bottom: 1px solid var(--border);
      }

      .modal-header h3 {
        font-size: 1.3rem;
      }

      .modal-close-btn {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: var(--text-light);
        line-height: 1;
      }

      .modal-body {
        padding: 24px;
      }

      .modal-footer {
        padding: 16px 24px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: flex-end;
        gap: 12px;
      }

      /* =============================================
         FORMULAIRES
      ============================================= */
      .form-group {
        margin-bottom: 16px;
      }

      .form-group label {
        display: block;
        font-size: 0.8rem;
        font-weight: 600;
        margin-bottom: 6px;
        color: var(--text-soft);
      }

      .form-group input,
      .form-group select,
      .form-group textarea {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid var(--border);
        border-radius: 10px;
        font-family: inherit;
        font-size: 0.85rem;
        transition: all 0.2s;
        background: white;
      }

      .form-group input:focus,
      .form-group select:focus,
      .form-group textarea:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px var(--primary-soft);
      }

      .form-row-2col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }

      /* =============================================
         SÉLECTEUR TYPE UTILISATEUR
      ============================================= */
      .user-type-selector {
        display: flex;
        gap: 24px;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--border);
      }

      .radio-option-label {
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        font-weight: 500;
      }

      .radio-option-label input {
        width: 18px;
        height: 18px;
        cursor: pointer;
      }

      /* Champs conditionnels selon type utilisateur */
      .conditional-fields {
        display: none;
      }

      .conditional-fields.active {
        display: block;
      }

      /* =============================================
         MULTI-SÉLECTION STAGIAIRES
      ============================================= */
      .multi-select-wrapper {
        position: relative;
        width: 100%;
      }

      .multi-select-trigger {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 14px;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 10px;
        cursor: pointer;
        font-size: 0.85rem;
      }

      .multi-select-options {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: white;
        border: 1px solid var(--border);
        border-radius: 10px;
        margin-top: 4px;
        max-height: 200px;
        overflow-y: auto;
        z-index: 10;
        display: none;
      }

      .multi-select-options.active {
        display: block;
      }

      .multi-select-option-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        cursor: pointer;
        transition: background 0.2s;
        font-size: 0.85rem;
      }

      .multi-select-option-item:hover {
        background: var(--bg);
      }

      .multi-select-option-item input[type="checkbox"] {
        width: 16px;
        height: 16px;
        cursor: pointer;
      }

      /* =============================================
         CARDS SEMAINES (dans modal phase)
      ============================================= */
      .week-card-form {
        background: var(--bg);
        border-radius: var(--radius-sm);
        padding: 16px;
        margin-bottom: 16px;
        border: 1px solid var(--border);
        position: relative;
      }

      .week-card-form h4 {
        font-size: 1rem;
        margin-bottom: 12px;
        color: var(--primary);
        font-weight: 600;
      }

      .btn-remove-week {
        position: absolute;
        top: 16px;
        right: 16px;
        background: none;
        border: none;
        cursor: pointer;
        color: var(--danger);
        font-size: 1rem;
        padding: 4px 8px;
        border-radius: 8px;
        transition: all 0.2s;
      }

      .btn-remove-week:hover {
        background: var(--danger-light);
      }

      /* =============================================
         CONTENU MESSAGE (modal)
      ============================================= */
      .message-detail-box {
        background: var(--bg);
        border-radius: var(--radius-sm);
        padding: 20px;
        margin-top: 16px;
        line-height: 1.6;
      }

      /* =============================================
         IMPORT EXCEL — PREVIEW
      ============================================= */
      .import-preview-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 16px;
        font-size: 0.75rem;
      }

      .import-preview-table th,
      .import-preview-table td {
        border: 1px solid var(--border);
        padding: 8px;
        text-align: left;
      }

      .import-preview-table th {
        background: var(--bg);
      }

      .import-status-valid { color: var(--success); }
      .import-status-error { color: var(--danger); }

      /* =============================================
         PAGES CACHÉES
      ============================================= */
      .page-section {
        display: none;
      }

      .page-section.active {
        display: block;
      }

      /* =============================================
         RESPONSIVE
      ============================================= */
      @media (max-width: 768px) {
        #sidebar {
          width: 80px;
        }

        #sidebar .sidebar-brand span,
        #sidebar .sidebar-nav li a span {
          display: none;
        }

        #content {
