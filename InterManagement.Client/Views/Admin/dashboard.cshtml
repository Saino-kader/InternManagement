    <!-- =============================================
         JAVASCRIPT — UI UNIQUEMENT
         Aucune donnée métier ici.
         Le JS gère seulement :
         - Navigation entre pages
         - Ouverture / fermeture modals
         - Toggle sidebar
         - Accordéon phases
         - Onglets semaines
         - Multi-sélection stagiaires
         - Gestion semaines dynamiques dans modal phase
         - Import Excel (lecture fichier + aperçu)
         - Notifications dropdown
    ============================================= -->
    <script>

      /* ============================================
         VARIABLES D'ÉTAT UI
         (aucune donnée métier)
      ============================================= */

      /** Callback exécuté lors de la confirmation de suppression */
      let deleteConfirmCallback = null;

      /** Données Excel lues, prêtes à être envoyées au backend */
      let importedExcelData = null;

      /** Noms des stagiaires sélectionnés dans le multi-select phase */
      let selectedStagiaireNames = [];

      /** Compteur de semaines dans le modal phase */
      let weekCardCount = 4;

      /** ID courant de l'utilisateur en mode édition (null si ajout) */
      let currentEditingUserId = null;

      /** Type courant de l'utilisateur dans le modal (stagiaire/mentor/admin) */
      let currentUserType = "stagiaire";

      /** ID courant du suivi en mode édition */
      let currentEditingSuiviId = null;

      /** ID courant de la phase en mode édition */
      let currentEditingPhaseId = null;


      /* ============================================
         NAVIGATION — CHANGEMENT DE PAGE
      ============================================= */

      /**
       * Initialise la navigation par onglets sidebar.
       * Cache toutes les pages et affiche seulement celle demandée.
       */
      function initNavigation() {
        document.querySelectorAll(".sidebar-nav > li[data-page]").forEach(navItem => {
          navItem.addEventListener("click", () => {
            const targetPage = navItem.dataset.page;

            // Retirer la classe active de tous les items
            document.querySelectorAll(".sidebar-nav > li").forEach(li => li.classList.remove("active"));
            navItem.classList.add("active");

            // Cacher toutes les pages
            document.querySelectorAll(".page-section").forEach(page => page.classList.remove("active"));

            // Afficher la page cible
            const pageMap = {
              dashboard:    "dashboardPage",
              utilisateurs: "utilisateursPage",
              phases:       "phasesPage",
              suivi:        "suiviPage"
            };

            const targetId = pageMap[targetPage];
            if (targetId) {
              document.getElementById(targetId).classList.add("active");
            }
          });
        });
      }


      /* ============================================
         SIDEBAR — TOGGLE COLLAPSE
      ============================================= */

      /**
       * Bascule l'état collapsed de la sidebar.
       */
      function initSidebarToggle() {
        document.getElementById("sidebarToggleBtn").addEventListener("click", () => {
          document.getElementById("sidebar").classList.toggle("collapsed");
        });
      }


      /* ============================================
         MODALS — OUVERTURE / FERMETURE
      ============================================= */

      /**
       * Ouvre un modal par son ID.
       * @param {string} modalId - L'ID de l'overlay modal à afficher
       */
      function openModal(modalId) {
        document.getElementById(modalId).classList.add("active");
      }

      /**
       * Ferme un modal par son ID.
       * @param {string} modalId - L'ID de l'overlay modal à masquer
       */
      function closeModal(modalId) {
        document.getElementById(modalId).classList.remove("active");
      }

      /**
       * Ferme un modal en cliquant sur l'overlay (fond sombre).
       */
      function initModalOverlayClose() {
        document.querySelectorAll(".modal-overlay").forEach(overlay => {
          overlay.addEventListener("click", (e) => {
            if (e.target === overlay) {
              overlay.classList.remove("active");
            }
          });
        });
      }


      /* ============================================
         MODAL UTILISATEUR — TOGGLE CHAMPS
      ============================================= */

      /**
       * Affiche ou masque les champs spécifiques selon le type sélectionné.
       * Appelé à chaque changement de radio "userType".
       */
      function toggleUserTypeFields() {
        const selectedType = document.querySelector('input[name="userType"]:checked').value;
        currentUserType = selectedType;

        document.getElementById("stagiaire-specific-fields").classList.toggle("active", selectedType === "stagiaire");
        document.getElementById("mentor-specific-fields").classList.toggle("active",   selectedType === "mentor");
        document.getElementById("admin-specific-fields").classList.toggle("active",    selectedType === "admin");

        // Masquer "Spécialité" pour les admins
        document.getElementById("wrapperUserSpecialite").style.display =
          selectedType === "admin" ? "none" : "block";
      }

      /**
       * Ouvre le modal utilisateur en mode "Ajout".
       * Réinitialise tous les champs.
       */
      function openAddUserModal() {
        currentEditingUserId = null;
        document.getElementById("userModalTitle").innerHTML =
          '<i class="fas fa-user" aria-hidden="true"></i> Ajouter un utilisateur';

        // Type par défaut : stagiaire
        document.querySelector('input[name="userType"][value="stagiaire"]').checked = true;
        toggleUserTypeFields();

        // Vider tous les champs
        document.getElementById("inputUserNom").value        = "";
        document.getElementById("inputUserPrenom").value     = "";
        document.getElementById("inputUserEmail").value      = "";
        document.getElementById("inputUserSpecialite").value = "";
        document.getElementById("selectUserStatut").value    = "Actif";
        document.getElementById("inputUserStructure").value  = "";
        document.getElementById("inputUserTheme").value      = "";
        document.getElementById("inputUserDateDebut").value  = "";
        document.getElementById("inputUserDateFin").value    = "";
        document.getElementById("inputUserDepartement").value = "Engineering";
        document.getElementById("selectUserRole").value      = "Administrateur";
        document.getElementById("hiddenUserId").value        = "";

        openModal("userModal");
      }

      /**
       * Ouvre le modal utilisateur en mode "Édition".
       * Pré-remplit les champs avec les données de la ligne cliquée.
       * @param {HTMLElement} btn - Le bouton edit cliqué
       */
      function openEditUserModal(btn) {
        const row      = btn.closest("tr");
        const userType = row.dataset.userType || "stagiaire";

        currentEditingUserId = row.dataset.userId || null;

        document.getElementById("userModalTitle").innerHTML =
          `<i class="fas fa-user" aria-hidden="true"></i> Modifier l'utilisateur`;

        document.querySelector(`input[name="userType"][value="${userType}"]`).checked = true;
        toggleUserTypeFields();

        // Pré-remplir depuis les data-attributes de la ligne
        document.getElementById("inputUserNom").value        = row.dataset.nom        || "";
        document.getElementById("inputUserPrenom").value     = row.dataset.prenom     || "";
        document.getElementById("inputUserEmail").value      = row.dataset.email      || "";
        document.getElementById("inputUserSpecialite").value = row.dataset.specialite || "";
        document.getElementById("selectUserStatut").value    = row.dataset.statut     || "Actif";

        if (userType === "stagiaire") {
          document.getElementById("inputUserStructure").value = row.dataset.structure  || "";
          document.getElementById("inputUserTheme").value     = row.dataset.theme      || "";
          document.getElementById("inputUserDateDebut").value = row.dataset.dateDebut  || "";
          document.getElementById("inputUserDateFin").value   = row.dataset.dateFin    || "";
        } else if (userType === "mentor") {
          document.getElementById("inputUserDepartement").value = row.dataset.departement || "Engineering";
        } else if (userType === "admin") {
          document.getElementById("selectUserRole").value = row.dataset.role || "Administrateur";
        }

        openModal("userModal");
      }


      /* ============================================
         MODAL PHASE — SEMAINES DYNAMIQUES
      ============================================= */

      /**
       * Génère le HTML d'une carte semaine dans le modal phase.
       * @param {number} weekIndex - Numéro de la semaine
       * @param {object} [data={}]  - Données pré-remplies (mode édition)
       * @returns {string} HTML de la carte
       */
      function buildWeekCardHTML(weekIndex, data = {}) {
        return `
          <div class="week-card-form" data-week-index="${weekIndex}">
            <button type="button" class="btn-remove-week" onclick="removeWeekCard(this)" aria-label="Supprimer la semaine ${weekIndex}">
              <i class="fas fa-trash" aria-hidden="true"></i>
            </button>
            <h4>Semaine ${weekIndex}</h4>
            <div class="form-group">
              <label for="weekCours${weekIndex}">Cours</label>
              <input type="text" id="weekCours${weekIndex}" placeholder="Nom du cours" value="${data.cours || ''}" autocomplete="off">
            </div>
            <div class="form-row-2col">
              <div class="form-group">
                <label for="weekDebut${weekIndex}">Date début</label>
                <input type="date" id="weekDebut${weekIndex}" value="${data.debut || ''}">
              </div>
              <div class="form-group">
                <label for="weekFin${weekIndex}">Date fin</label>
                <input type="date" id="weekFin${weekIndex}" value="${data.fin || ''}">
              </div>
            </div>
          </div>`;
      }

      /**
       * Ajoute une nouvelle carte semaine dans le modal phase.
       */
      function addWeekCard() {
        weekCardCount++;
        const container = document.getElementById("phaseWeeksContainer");
        const addBtn    = document.getElementById("addWeekCardBtn");

        const tempDiv = document.createElement("div");
        tempDiv.innerHTML = buildWeekCardHTML(weekCardCount);

        // Insérer avant le bouton "Ajouter"
        container.insertBefore(tempDiv.firstElementChild, addBtn);
      }

      /**
       * Supprime une carte semaine du modal phase.
       * @param {HTMLElement} btn - Le bouton de suppression cliqué
       */
      function removeWeekCard(btn) {
        btn.closest(".week-card-form").remove();
      }

      /**
       * Génère le bouton "Ajouter une semaine" et l'ajoute au container.
       */
      function appendAddWeekButton() {
        const existing = document.getElementById("addWeekCardBtn");
        if (existing) return;

        const btn = document.createElement("button");
        btn.type      = "button";
        btn.id        = "addWeekCardBtn";
        btn.className = "btn-add-week";
        btn.setAttribute("aria-label", "Ajouter une semaine");
        btn.innerHTML = '<i class="fas fa-plus" aria-hidden="true"></i> Ajouter une semaine';
        btn.onclick   = addWeekCard;

        document.getElementById("phaseWeeksContainer").appendChild(btn);
      }

      /**
       * Ouvre le modal phase en mode "Ajout".
       * Initialise 4 semaines par défaut.
       */
      function openAddPhaseModal() {
        currentEditingPhaseId = null;
        weekCardCount         = 4;
        selectedStagiaireNames = [];

        document.getElementById("phaseModalTitle").innerHTML =
          '<i class="fas fa-diagram-project" aria-hidden="true"></i> Ajouter une phase';

        document.getElementById("inputPhaseNumero").value  = "";
        document.getElementById("inputPhaseTitre").value   = "";
        document.getElementById("inputPhaseDateDebut").value = "";
        document.getElementById("inputPhaseDateFin").value  = "";
        document.getElementById("multiSelectLabel").textContent = "Aucun stagiaire sélectionné";

        // Générer 4 semaines vides
        let weeksHTML = "";
        for (let i = 1; i <= 4; i++) {
          weeksHTML += buildWeekCardHTML(i);
        }
        document.getElementById("phaseWeeksContainer").innerHTML = weeksHTML;
        appendAddWeekButton();

        openModal("phaseModal");
      }


      /* ============================================
         MULTI-SELECT STAGIAIRES
      ============================================= */

      /**
       * Bascule l'affichage de la liste déroulante multi-select.
       */
      function toggleMultiSelectDropdown() {
        const dropdown = document.getElementById("stagiairesDropdown");
        const trigger  = document.getElementById("multiSelectTrigger");
        const isOpen   = dropdown.classList.toggle("active");
        trigger.setAttribute("aria-expanded", isOpen);
      }

      /**
       * Met à jour le label du multi-select après sélection.
       */
      function updateMultiSelectLabel() {
        const checkedBoxes = document.querySelectorAll(".stagiaire-checkbox:checked");
        selectedStagiaireNames = Array.from(checkedBoxes).map(cb => cb.closest("label").textContent.trim());

        document.getElementById("multiSelectLabel").textContent =
          selectedStagiaireNames.length
            ? selectedStagiaireNames.join(", ")
            : "Aucun stagiaire sélectionné";
      }

      /**
       * Initialise les événements de la liste déroulante multi-select.
       */
      function initMultiSelect() {
        document.getElementById("multiSelectTrigger").addEventListener("click", toggleMultiSelectDropdown);

        document.querySelectorAll(".stagiaire-checkbox").forEach(cb => {
          cb.addEventListener("change", updateMultiSelectLabel);
        });

        // Fermer en cliquant ailleurs
        document.addEventListener("click", (e) => {
          const wrapper = document.querySelector(".multi-select-wrapper");
          if (wrapper && !wrapper.contains(e.target)) {
            document.getElementById("stagiairesDropdown").classList.remove("active");
            document.getElementById("multiSelectTrigger").setAttribute("aria-expanded", "false");
          }
        });
      }


      /* ============================================
         ACCORDÉON PHASES
      ============================================= */

      /**
       * Initialise le comportement d'ouverture/fermeture des accordéons.
       * Ouvre automatiquement le premier.
       */
      function initPhaseAccordion() {
        document.querySelectorAll(".phase-accordion-header").forEach(header => {
          header.addEventListener("click", () => {
            const body    = header.nextElementSibling;
            const chevron = header.querySelector(".phase-accordion-chevron");
            const isOpen  = body.classList.toggle("active");

            header.setAttribute("aria-expanded", isOpen);
            chevron.classList.toggle("fa-chevron-down",  !isOpen);
            chevron.classList.toggle("fa-chevron-right",  isOpen);
          });
        });

        // Ouvrir le premier accordéon par défaut
        const firstHeader = document.querySelector(".phase-accordion-header");
        if (firstHeader) firstHeader.click();
      }


      /* ============================================
         ONGLETS SEMAINES (accordéon phases)
      ============================================= */

      /**
       * Active l'onglet semaine cliqué et met à jour l'affichage.
       * Le contenu réel sera chargé depuis le backend.
       * @param {HTMLElement} btn        - Le bouton onglet cliqué
       * @param {number}      phaseNum   - Numéro de la phase
       * @param {number}      weekNum    - Numéro de la semaine
       */
      function switchWeekTab(btn, phaseNum, weekNum) {
        // Désactiver tous les onglets de cette phase
        const phaseAccordion = btn.closest(".phase-accordion");
        phaseAccordion.querySelectorAll(".week-tab-btn").forEach(tab => {
          tab.classList.remove("active");
        });

        btn.classList.add("active");

        // Afficher un message placeholder — le backend injectera les vraies données
        const contentDiv = document.getElementById(`phase${phaseNum}Content`);
        if (contentDiv) {
          contentDiv.innerHTML = `
            <p style="color: var(--text-soft); padding: 16px 0;">
              Contenu de la semaine ${weekNum} — sera chargé depuis le backend.
            </p>`;
        }
      }


      /* ============================================
         MODAL SUIVI — OUVERTURE
      ============================================= */

      /**
       * Ouvre le modal suivi en mode "Ajout".
       */
      function openAddSuiviModal() {
        currentEditingSuiviId = null;
        document.getElementById("suiviModalTitle").innerHTML =
          '<i class="fas fa-chart-line" aria-hidden="true"></i> Ajouter un suivi';

        document.getElementById("inputSuiviDate").value              = new Date().toISOString().split("T")[0];
        document.getElementById("inputSuiviCours").value             = "";
        document.getElementById("textareaSuiviCommentaire").value    = "";
        document.getElementById("selectSuiviStatut").value           = "En cours";

        openModal("suiviModal");
      }


      /* ============================================
         NOTIFICATIONS DROPDOWN
      ============================================= */

      /**
       * Initialise le dropdown de notifications (cloche).
       */
      function initNotificationDropdown() {
        const bell     = document.getElementById("notificationBell");
        const dropdown = document.getElementById("notificationDropdown");

        bell.addEventListener("click", (e) => {
          e.stopPropagation();
          dropdown.classList.toggle("active");
        });

        // Fermer en cliquant ailleurs
        document.addEventListener("click", () => {
          dropdown.classList.remove("active");
        });
      }


      /* ============================================
         SUPPRESSION — MODAL CONFIRMATION
      ============================================= */

      /**
       * Ouvre le modal de confirmation de suppression.
       * @param {string}   message  - Message affiché dans le modal
       * @param {Function} callback - Fonction à exécuter si confirmé
       */
      function openDeleteConfirmModal(message, callback) {
        document.getElementById("deleteConfirmMessage").textContent = message;
        deleteConfirmCallback = callback;
        openModal("deleteConfirmModal");
      }

      /**
       * Initialise le bouton de confirmation de suppression.
       */
      function initDeleteConfirm() {
        document.getElementById("confirmDeleteBtn").addEventListener("click", () => {
          if (deleteConfirmCallback) {
            deleteConfirmCallback();
            deleteConfirmCallback = null;
          }
          closeModal("deleteConfirmModal");
        });
      }


      /* ============================================
         IMPORT EXCEL — LECTURE FICHIER + APERÇU
      ============================================= */

      /**
       * Lit le fichier Excel sélectionné et affiche un aperçu.
       * Aucune validation métier ici — le backend validera les données.
       */
      function initExcelImport() {
        document.getElementById("importFileInput").addEventListener("change", function(e) {
          const file = e.target.files[0];
          if (!file) return;

          const reader = new FileReader();
          reader.onload = function(evt) {
            const data     = new Uint8Array(evt.target.result);
            const workbook = XLSX.read(data, { type: "array" });
            const sheet    = workbook.Sheets[workbook.SheetNames[0]];
            const rows     = XLSX.utils.sheet_to_json(sheet);

            importedExcelData = rows;

            // Afficher un aperçu des 5 premières lignes
            if (rows.length === 0) {
              document.getElementById("importPreviewArea").innerHTML =
                '<p class="import-status-error">Aucune donnée trouvée dans le fichier.</p>';
              document.getElementById("confirmImportBtn").style.display = "none";
              return;
            }

            const headers    = Object.keys(rows[0]);
            const previewMax = Math.min(5, rows.length);

            let previewHTML = `
              <p class="import-status-valid" style="margin-top:16px;">
                ✓ ${rows.length} ligne(s) lue(s)
              </p>
              <p style="margin-top:12px;"><strong>Aperçu (${previewMax} premières lignes) :</strong></p>
              <table class="import-preview-table">
                <thead>
                  <tr>${headers.map(h => `<th>${h}</th>`).join("")}</tr>
                </thead>
                <tbody>`;

            rows.slice(0, previewMax).forEach(row => {
              previewHTML += `<tr>${headers.map(h => `<td>${row[h] ?? ""}</td>`).join("")}</tr>`;
            });

            if (rows.length > 5) {
              previewHTML += `<tr><td colspan="${headers.length}" style="text-align:center; color:var(--text-light);">... et ${rows.length - 5} autre(s) ligne(s)</td></tr>`;
            }

            previewHTML += "</tbody></table>";
            document.getElementById("importPreviewArea").innerHTML = previewHTML;
            document.getElementById("confirmImportBtn").style.display = "inline-flex";
          };
          reader.readAsArrayBuffer(file);
        });
      }

      /**
       * Télécharge un modèle Excel vide pour l'import.
       */
      function downloadImportTemplate() {
        const templateRow = [{
          Stagiaire:    "Moussa Diallo",
          Mentor:       "Sophie Martin",
          Date:         "2025-01-12",
          Semaine:      "Semaine 1",
          Cours:        "Introduction",
          Appreciation: "Très bien",
          Commentaire:  "Bon travail",
          Statut:       "Validé"
        }];

        const ws = XLSX.utils.json_to_sheet(templateRow);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "Template_Suivi");
        XLSX.writeFile(wb, "template_suivi_stagiaires.xlsx");
      }


      /* ============================================
         INITIALISATION — EVENTS BUTTONS
      ============================================= */

      function initButtonEvents() {

        // Bouton "Ajouter utilisateur"
        document.getElementById("openAddUserBtn").addEventListener("click", openAddUserModal);

        // Bouton "Ajouter phase"
        document.getElementById("openAddPhaseBtn").addEventListener("click", openAddPhaseModal);

        // Bouton "Import" suivi
        document.getElementById("openImportBtn").addEventListener("click", () => {
          document.getElementById("importFileInput").value  = "";
          document.getElementById("importPreviewArea").innerHTML = "";
          document.getElementById("confirmImportBtn").style.display = "none";
          importedExcelData = null;
          openModal("importExportModal");
        });

        // Bouton "Ajouter suivi"
        document.getElementById("openAddSuiviBtn").addEventListener("click", openAddSuiviModal);

        // Bouton "Télécharger modèle"
        document.getElementById("downloadTemplateBtn").addEventListener("click", downloadImportTemplate);

        // Radio userType
        document.querySelectorAll('input[name="userType"]').forEach(radio => {
          radio.addEventListener("change", toggleUserTypeFields);
        });

        // Bouton "Enregistrer" utilisateur (placeholder — brancher au backend)
        document.getElementById("saveUserBtn").addEventListener("click", () => {
          // TODO : envoyer les données au backend via fetch / form submit
          closeModal("userModal");
        });

        // Bouton "Enregistrer" phase (placeholder)
        document.getElementById("savePhaseBtn").addEventListener("click", () => {
          // TODO : envoyer les données au backend
          closeModal("phaseModal");
        });

        // Bouton "Enregistrer" suivi (placeholder)
        document.getElementById("saveSuiviBtn").addEventListener("click", () => {
          // TODO : envoyer les données au backend
          closeModal("suiviModal");
        });

        // Bouton "Confirmer import"
        document.getElementById("confirmImportBtn").addEventListener("click", () => {
          if (importedExcelData) {
            // TODO : envoyer importedExcelData au backend via fetch
            closeModal("importExportModal");
          }
        });
      }


      /* ============================================
         POINT D'ENTRÉE — INITIALISATION GLOBALE
      ============================================= */

      document.addEventListener("DOMContentLoaded", () => {
        initNavigation();
        initSidebarToggle();
        initModalOverlayClose();
        initPhaseAccordion();
        initMultiSelect();
        initNotificationDropdown();
        initDeleteConfirm();
        initExcelImport();
        initButtonEvents();
      });


      /* ============================================
         EXPOSITION GLOBALE
         (nécessaire pour les onclick inline HTML)
      ============================================= */
      window.openModal            = openModal;
      window.closeModal           = closeModal;
      window.openDeleteConfirmModal = openDeleteConfirmModal;
      window.switchWeekTab        = switchWeekTab;
      window.removeWeekCard       = removeWeekCard;
      window.toggleMultiSelectDropdown = toggleMultiSelectDropdown;

    </script>

  </body>
</html>
